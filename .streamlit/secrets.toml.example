# Copie este contenido en Streamlit Cloud → Settings → Secrets (o en .streamlit/secrets.toml en local).

# Clave para entrar a la app (muy recomendado: la dirección de Streamlit es pública)
APP_PASSWORD = "elija-una-clave"

# Base de datos Postgres (Neon). Sin esto se usa una base temporal que se borra al reiniciar.
# Pegue la dirección tal como la copia de Neon (botón Connect), entre comillas:
# DATABASE_URL = "postgresql://usuario:clave@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Opcional: IA para los casos dudosos (la app funciona sin ella)
# ANTHROPIC_API_KEY = "sk-ant-..."
