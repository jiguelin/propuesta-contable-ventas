# Copie este contenido en Streamlit Cloud → Settings → Secrets (o en .streamlit/secrets.toml en local).

# Clave para entrar a la app (muy recomendado: la dirección de Streamlit es pública)
APP_PASSWORD = "elija-una-clave"

# Base de datos Postgres (Supabase o Neon). Sin esto se usa una base temporal que se borra al reiniciar.
# DATABASE_URL = "postgresql+psycopg2://usuario:clave@host:5432/postgres"

# Opcional: IA para los casos dudosos (la app funciona sin ella)
# ANTHROPIC_API_KEY = "sk-ant-..."
